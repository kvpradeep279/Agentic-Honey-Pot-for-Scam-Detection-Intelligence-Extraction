# ===========================================
# Environment Variables Template
# ===========================================
# WHY: This file is a template for the actual .env file
# Copy this to .env and fill in your actual values
# NEVER commit .env to git (it contains secrets!)
# ===========================================

# Your honeypot API key - clients must send this to access your API
# Make this something secure and random!
HONEYPOT_API_KEY=your-secret-api-key-here

# Google Gemini API Keys (FREE!)
# Get yours at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-primary-gemini-key
GEMINI_API_KEY_2=your-second-gemini-key    # Optional: enables round-robin key rotation

# Grok / xAI API Key (Optional fallback)
# Get yours at: https://console.x.ai/
GrokAI_API_KEY=your-grok-xai-key           # Optional: fallback when Gemini rate-limited

# OpenAI API Key (optional, if you prefer GPT)
# OPENAI_API_KEY=your-openai-api-key-here

